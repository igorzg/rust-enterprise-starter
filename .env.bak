# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
# Host/port the API listens on. Use 0.0.0.0 inside containers.
APP_HOST=0.0.0.0
APP_PORT=8080

# Log level for tracing (error, warn, info, debug, trace, or filters like
# "info,rstarter=debug,sqlx=debug").
RUST_LOG=info

# Log output format: "pretty" (human-readable) or "json" (structured).
LOG_FORMAT=pretty

# Comma-separated list of allowed CORS origins, or * to allow any origin.
# Empty means no CORS headers (same-origin only).
CORS_ALLOWED_ORIGINS=

# TTL in seconds for cached user entries in Redis.
CACHE_TTL_SECS=300

# ------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------
# Credentials used by the postgres service in Docker Compose, and
# interpolated into the DATABASE_URL passed to the migrate and app
# services (pointing at the `postgres` service name).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Connection string used when running the application natively
# (e.g. `cargo run`) against a local PostgreSQL instance.
# Inside Docker Compose, the compose files always override this with a
# URL that uses the `postgres` service name.
DATABASE_URL=postgres://app:app@localhost:5432/app

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
# Connection string used when running the application natively.
# Inside Docker Compose, the compose files always override this with
# redis://redis:6379.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# Host port mappings (development compose file only)
# ------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
